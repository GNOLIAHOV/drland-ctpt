# Postgres container (docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-strong-postgres-password
POSTGRES_DB=core_api
POSTGRES_PORT=5433

# Prisma connection string
# - Khi chạy dev local trên máy: localhost:5433
# - Khi chạy bằng docker compose --profile prod: docker-compose tự trỏ sang postgres:5432
DATABASE_URL="postgresql://postgres:change-this-strong-postgres-password@localhost:5433/core_api?schema=public"

# App
PORT=3001

# JWT — tạo chuỗi ngẫu nhiên bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-min-48-chars"
JWT_EXPIRES_IN=1d

# Tài khoản quản trị ban đầu (chạy: npx prisma db seed)
ADMIN_EMAIL=chutro@domain.vn
ADMIN_PASSWORD="ChangeMe@123456"
ADMIN_FULL_NAME="Quản Lý Hệ Thống"

# SMTP (Gửi email thông báo khi có khách đặt lịch xem phòng)
# Khuyên dùng Gmail App Password:
#   1. Bật Xác minh 2 bước (2FA) trên tài khoản Google
#   2. Tạo Mật khẩu ứng dụng tại https://myaccount.google.com/apppasswords
#   3. Điền SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=email@gmail.com, SMTP_PASS=16-ky-tu-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Hệ Thống DRLAND <your-gmail@gmail.com>"
