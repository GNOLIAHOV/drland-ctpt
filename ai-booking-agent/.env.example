PORT=8000

# URL tới core-api (trong Docker compose --profile prod tự trỏ http://core-api:3001)
CORE_API_BASE_URL=http://localhost:3001

# Google Gemini API Key (khuyên dùng gói trả phí Pay-as-you-go tại https://aistudio.google.com để không bị giới hạn 20 lượt/ngày)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
